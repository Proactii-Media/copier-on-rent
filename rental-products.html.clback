		<!-- footer area end -->

		<!--Super Offer Sticky--> 
		<div class="sticky-container">
			<ul class="sticky-2">
				<li class="chat">
					<span type="button" data-toggle="modal" data-target="#superOffer"><a href="#"><img src="assets/img/offer.png" class="offer-img" alt=""></a></span>
				</li>
			</ul>
		</div>

		<!-- free demo model -->
		<div class="container">
			<!-- The Modal -->
			<div class="modal fade" id="freeDemo">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">
						<!-- Modal Header -->
						<div class="modal-header">
							<h4 class="modal-title">7 Days Free Demo</h4>
							<button type="button" class="close" data-dismiss="modal">&times;</button>
						</div>
						<!-- Modal body -->
						<div class="modal-body">
							<form role="form" method="post" id="freeDemoForm" name="freeDemoForm" >
                        
								<div class="form-group">
									<label for="name"> Name:</label>
									<input type="text" class="form-control" id="name" name="name" onkeyup="isNull(this.id)">
									<font color="#FF0000" size="-5">
										<span class="val-msg">
										</span>
									</font>
								</div>
								<div class="form-group">
									<label for="email">Email:</label>
									<input type="email" class="form-control" id="email" name="email" onkeyup="return isEmail(this.id)">
									<font color="#FF0000" size="-5">
										<span class="val-msg">
										</span>
									</font>
								</div>
								<div class="form-group">
									<label for="phone Number"> Phone:</label>
									<input type="text" class="form-control" id="phone" name="phone"  onkeypress="return isNum(event)" onblur="isMobile(this.id)" maxlength="11">
									<font color="#FF0000" size="-5">
										<span class="val-msg">
										</span>
									</font>
								</div>
								<div class="form-group">
									<label for="name">Message:</label>
									<textarea class="form-control" name="message" id="message" placeholder="Your Message Here" rows="7"></textarea>
									<font color="#FF0000" size="-5">
										<span class="val-msg">
										</span>
									</font>
								</div>
                       
							</form>
							<button type="submit" class="btn btn-lg btn-success btn-block" id="btnFreeDemo" onclick="freeDemo()">Submit →</button>
						</div>
                
						<!-- Modal footer -->
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
						</div>
                
					</div>
				</div>
			</div>
		</div>
		<!-- offer modal -->
		<div class="container">
			<!-- The Modal -->
			<div class="modal fade" id="superOffer">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">
						<!-- Modal Header -->
						<div class="modal-header">
							<h4 class="modal-title">Super Offer</h4>
							<button type="button" class="close" data-dismiss="modal">&times;</button>
						</div>
						<!-- Modal body -->
						<div class="modal-body">
							<div class="modal-banner">
								<img src="assets\img\discount-banner.jpg"/>
								<!--<img src="assets\img\free demo 1.png" class="logo-img brand-logo free-demo" alt="brand-logo" data-toggle="modal" data-target="#freeDemo">-->
							</div>
							<form role="form" method="post" id="superOfferForm" name="superOfferForm" >
								<div class="form-group">
									<label for="name"> Name:</label>
									<input type="text" class="form-control" id="offer_name" name="offer_name" onkeyup="isNull(this.id)">
									<font color="#FF0000" size="-5">
										<span class="val-msg">
										</span>
									</font>
								</div>
								<div class="form-group">
									<label for="email">Email:</label>
									<input type="email" class="form-control" id="offer_email" name="offer_email" onkeyup="return isEmail(this.id)">
									<font color="#FF0000" size="-5">
										<span class="val-msg">
										</span>
									</font>
								</div>
								<div class="form-group">
									<label for="phone Number"> Phone:</label>
									<input type="text" class="form-control" id="offer_phone" name="offer_phone"  onkeypress="return isNum(event)" onblur="isMobile(this.id)" maxlength="11">
									<font color="#FF0000" size="-5">
										<span class="val-msg">
										</span>
									</font>
								</div>
								<div class="form-group">
									<label for="name">Message:</label>
									<textarea class="form-control" name="offer_message" id="offer_message" placeholder="Your Message Here" rows="7"></textarea>
									<font color="#FF0000" size="-5">
										<span class="val-msg">
										</span>
									</font>
								</div>
							</form>
							<button type="submit" class="btn btn-lg btn-success btn-block" id="btnSuperOffer" onclick="superOffer()">Submit →</button>
						</div>
						<!-- Modal footer -->
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Thank you modal -->
		<div class="container">
			<!-- The Modal -->
			<div class="modal fade" id="thankModal">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">
						<!-- Modal Header -->
						<!-- Modal body -->
						<div class="modal-body">
							<div class="thank-content">
								<h3>Thank You!</h3>
							</div>
						</div>
						<!-- Modal footer -->
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
						</div>
					</div>
				</div>
			</div>
		</div>
			
		<!-- all js include here -->
		<script src="assets\js\vendor\jquery-1.12.4.min.js"></script>
		<script src="assets\js\popper.min.js"></script>
		<script src="assets\js\bootstrap.min.js"></script>
		<script src="assets\js\plugins.js"></script>
		<script src="assets\js\ajax-mail.js"></script>
		<script src="assets\js\main.js"></script>
		<script src="assets\js\script.js"></script>
</body>
</html>